import random

import discord
from discord import app_commands
from discord.ext import commands


class Fun(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.command(name="coinflip")
    async def coinflip(self, ctx):
        """Gira uma moeda."""
        result = random.choice(["Cara", "Coroa"])
        await ctx.send(f"🪙 Resultado: **{result}**")

    @commands.command(name="roll", aliases=["dice"])
    async def roll(self, ctx, sides: int = 6):
        """Rola um dado com N lados."""
        if sides <= 0:
            await ctx.send("❌ O número de lados deve ser maior que zero.")
            return
        await ctx.send(f"🎲 Resultado: **{random.randint(1, sides)}**")

    @commands.command(name="choose")
    async def choose(self, ctx, *options):
        """Escolhe uma opção aleatória."""
        if not options:
            await ctx.send("❌ Dê pelo menos uma opção, ex.: !choose café chá água")
            return
        await ctx.send(f"🎯 Escolha: **{random.choice(options)}**")

    @commands.command(name="8ball")
    async def eight_ball(self, ctx, *, question: str):
        """Responde uma pergunta."""
        responses = [
            "Sim.",
            "Não.",
            "Com certeza.",
            "Acho que sim.",
            "Acho que não.",
            "Tente novamente mais tarde.",
            "Melhor não dizer agora.",
        ]
        await ctx.send(f"🎱 {random.choice(responses)}")

    @app_commands.command(name="coinflip", description="Gira uma moeda")
    async def coinflip_slash(self, interaction: discord.Interaction):
        await interaction.response.send_message(f"🪙 Resultado: **{random.choice(['Cara', 'Coroa'])}**")

    @app_commands.command(name="roll", description="Rola um dado")
    @app_commands.describe(sides="Quantidade de lados do dado")
    async def roll_slash(self, interaction: discord.Interaction, sides: int = 6):
        if sides <= 0:
            await interaction.response.send_message("❌ O número de lados deve ser maior que zero.")
            return
        await interaction.response.send_message(f"🎲 Resultado: **{random.randint(1, sides)}**")


async def setup(bot):
    await bot.add_cog(Fun(bot))
